# ControlPlane environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# --- Upstream LLM provider (OpenAI-compatible) ---
# ControlPlane forwards allowed requests to this provider.
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=sk-replace-me
UPSTREAM_DEFAULT_MODEL=gpt-4o-mini

# --- Postgres (audit ledger, policy state) ---
DATABASE_URL=postgresql+asyncpg://controlplane:controlplane@localhost:5432/controlplane

# --- Tenant selection ---
# Name of the config file (without .yaml) under configs/ to use when a
# request does not specify a tenant explicitly.
DEFAULT_TENANT=customer_support

# --- Demo lead intake (SMTP or Resend) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
DEMO_NOTIFICATION_EMAIL=your_email@gmail.com
# Or using Resend:
# RESEND_API_KEY=re_your_api_key

